<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Dev Mode (Phase 3): the per-target TCC prompt string shown the first time
	     Zerro reads the browser's localhost address to auto-match the project
	     folder. Required alongside the apple-events entitlement. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>Zerro reads your browser’s current localhost address to auto-match your Dev Mode project folder. Only localhost addresses are read, and only while you’re in Dev Mode.</string>
	<!-- Production PostHog key. Only Release builds transmit; DEBUG builds
	     disable analytics entirely (see Analytics.start). -->
	<key>POSTHOG_API_KEY</key>
	<string>phc_tW2QmWsUwgn2pAAq7ynDWTxcHiP97vG5LdQfRtXD9dAy</string>
	<key>POSTHOG_HOST</key>
	<string>https://us.i.posthog.com</string>
	<!-- Managed backend base URL. Wired to the per-configuration
	     ZERRO_FUNCTIONS_BASE_URL build setting (see apps/desktop/Config/*.xcconfig)
	     so the Staging build talks to the staging Supabase project while the
	     production build stays pinned to prod. Read by ManagedBackend. -->
	<key>ZerroFunctionsBaseURL</key>
	<string>$(ZERRO_FUNCTIONS_BASE_URL)</string>
	<!-- Sparkle appcast. Wired to the per-configuration SU_FEED_URL build
	     setting so each build checks its own update feed. -->
	<key>SUFeedURL</key>
	<string>$(SU_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>IV0J9TIWJpe/dL5A/8NvDhfmsjZatlrJA1NPnmX2xiE=</string>
	<!-- Billing: the `zerro://` scheme LemonSqueezy bounces back to after a
	     checkout (each product's "Redirect URL after purchase" =
	     zerro://checkout-complete?product=<product>). Handled in
	     AppDelegate.application(_:open:). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.cbreeding.Zerro.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>zerro</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
