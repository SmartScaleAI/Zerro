# =============================================================================
# Local model-testing env for `supabase functions serve` (NOT used in prod —
# production reads Supabase secrets). Copy to supabase/.env.local (gitignored),
# fill in real values, then:
#
#   supabase start                                      # local DB (once)
#   supabase functions serve --env-file supabase/.env.local
#
# Point a DEBUG build at it by setting ZERRO_FUNCTIONS_BASE_URL =
# http://127.0.0.1:54321/functions/v1 in the Xcode scheme's environment
# variables (Product > Scheme > Edit Scheme > Run > Arguments). Record as
# normal — the generation runs through whatever model is set below. Change
# the model = edit this file + restart serve. No deploy, prod untouched.
# =============================================================================

# --- Model under test --------------------------------------------------------
CHAT_PROVIDER=gemini
CHAT_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=low
# CHAT_MODEL=gemini-3.1-pro-preview     # swap to A/B Pro
# CHAT_PROVIDER=openai
# CHAT_MODEL=gpt-4o                     # baseline comparison

# --- Keys (same values as the prod secrets) ----------------------------------
OPENAI_API_KEY=sk-REPLACE_ME
GEMINI_API_KEY=REPLACE_ME

# --- Session auth — must match what the app's JWT was signed with ------------
# Use the SAME value as the deployed SESSION_JWT_SECRET so a debug build that
# already holds a valid session token authenticates against the local function.
SESSION_JWT_SECRET=REPLACE_ME
